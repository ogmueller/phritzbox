# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=df75d43e4f3679073fa4efc89792bb5e
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=5.7"
DATABASE_URL="postgresql://db_user:db_password@127.0.0.1:5432/db_name?serverVersion=13&charset=utf8"
###< doctrine/doctrine-bundle ###
###> phritzbox ###
# your fritzbox login
APP_API_USERNAME=api
# your fritzbox password
APP_API_PASSWORD=

# change the hostname, if needed
#APP_API_DOMAIN=https://abcd1234ef.myfritz.net
#APP_API_DOMAIN=https://192.168.10.123
APP_API_DOMAIN=http://fritz.box

# usually the following should not be changed
APP_API_URL_LOGIN=${APP_API_DOMAIN}/login_sid.lua
APP_API_URL_AHA=${APP_API_DOMAIN}/webservices/homeautoswitch.lua

###> lexik/jwt-authentication-bundle ###
# Run: php app/bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme
###< lexik/jwt-authentication-bundle ###

###> phritzbox refresh token ###
# Lifetime of a refresh token in seconds (default: 30 days). The short-lived
# JWT keeps its own token_ttl; the refresh token is what survives across it.
REFRESH_TOKEN_TTL=2592000
###< phritzbox refresh token ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> phritzbox alerting ###
# Sender address used for alert e-mails (configure MAILER_DSN to actually send)
APP_ALERT_FROM=alerts@phritzbox.local
###< phritzbox alerting ###

###> phritzbox data lifecycle ###
# Where cron:data:backup writes its snapshots. The default is inside the
# persisted data volume: that survives container rebuilds and protects against
# corruption or a bad migration, but NOT against losing the volume itself.
# Point it at a bind mount to get copies that outlive the host.
APP_BACKUP_DIR="%kernel.project_dir%/../data/backups"
# How many snapshots to keep. Each is a gzipped copy of the whole database, so
# raise this only once you know what one costs on disk.
APP_BACKUP_KEEP=3

# Retention, in days. 0 = keep forever, which is the default for every tier:
# cron:data:prune deletes nothing until you opt in. Raw readings are only ever
# removed where a rollup bucket already covers them, so a rollup job that has not
# run means nothing is pruned regardless of these values.
#
# The same readings are kept at three resolutions, each the fallback for the one
# above it — which is what a window really costs:
#   RAW     every individual reading (~24s apart for power/voltage). ~98% of the
#           database. Pruning it leaves 15-minute detail for that period.
#   QUARTER one summary per 15 minutes (avg/min/max). Pruning it leaves daily
#           detail for that period.
#   DAILY   one summary per day. Tiny (~22k rows for seven years) and the last
#           tier there is — pruning it removes that history for good, so leave
#           this at 0.
APP_RETENTION_RAW_DAYS=0
APP_RETENTION_QUARTER_DAYS=0
APP_RETENTION_DAILY_DAYS=0
# Per-metric overrides of the raw window: comma-separated "metric=days" pairs.
# Valid metric names are exactly: temperature, power, voltage, energy, battery,
# presence. Anything else is ignored (cron:data:prune warns about it), as is a
# value of 0 or less — so a typo can never be read as "delete everything".
# Only power and voltage are worth overriding; together they are ~99% of all
# stored rows, and mains voltage barely changes. Example:
#   APP_RETENTION_RAW_OVERRIDES=voltage=14,power=90
APP_RETENTION_RAW_OVERRIDES=
# Alert history (0 = keep forever) and rotated log files.
APP_RETENTION_ALERT_EVENT_DAYS=0
APP_RETENTION_LOG_DAYS=14
###< phritzbox data lifecycle ###
