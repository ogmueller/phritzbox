# Fritz!Box credentials (required)
APP_API_USERNAME=your-fritzbox-username
APP_API_PASSWORD=your-fritzbox-password
APP_API_DOMAIN=http://fritz.box

# Security (change these for production!)
APP_SECRET=change-me-to-a-random-string
JWT_PASSPHRASE=change-me-to-a-random-passphrase

# Server name / domain (default: http://localhost)
# Use http:// prefix for plain HTTP:
# SERVER_NAME=http://localhost
# To enable automatic HTTPS via Let's Encrypt, use a bare domain (no http:// prefix):
# SERVER_NAME=phritzbox.example.com

# Port to expose the web UI (default: 80)
# PHRITZBOX_PORT=80

# Alerting — e-mail delivery (optional; webhook alerts need no mail server).
# Set a real DSN to send e-mail alerts, e.g. smtp://user:pass@smtp.example.com:587
# MAILER_DSN=null://null
# Sender address used for alert e-mails:
# APP_ALERT_FROM=alerts@phritzbox.local

# Database backups (cron:data:backup).
# By default snapshots land in the persisted data volume, which protects against
# corruption and bad migrations but NOT against losing the volume. To keep copies
# off the host, bind-mount a directory into the app service and point this at it.
# APP_BACKUP_DIR=/application/data/backups
# How many snapshots to retain. Each one is a gzipped copy of the whole database.
# APP_BACKUP_KEEP=3

# Retention (cron:data:prune). All 0 = keep everything, and nothing is deleted
# until you change that. Readings are kept at three resolutions, each the
# fallback for the one above it:
#   RAW     every individual reading (~24s apart for power/voltage) — ~98% of the
#           database. Pruning leaves 15-minute detail for that period.
# APP_RETENTION_RAW_DAYS=0
#   QUARTER one summary per 15 minutes (avg/min/max). Pruning leaves daily detail.
# APP_RETENTION_QUARTER_DAYS=0
#   DAILY   one summary per day — tiny, and the last tier there is. Pruning it
#           removes that history for good, so leave it at 0.
# APP_RETENTION_DAILY_DAYS=0
# Per-metric override of the raw window: comma-separated "metric=days" pairs.
# Valid names: temperature, power, voltage, energy, battery, presence.
# Only power and voltage are worth overriding (~99% of all rows between them).
# Unknown names and values of 0 or less are ignored; cron:data:prune warns.
# APP_RETENTION_RAW_OVERRIDES=voltage=14,power=90
# Alert activity log, and rotated log files.
# APP_RETENTION_ALERT_EVENT_DAYS=0
# APP_RETENTION_LOG_DAYS=14
